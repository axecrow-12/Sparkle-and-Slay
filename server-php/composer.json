{
    "name": "sparkle-and-slay/server-php",
    "description": "Sparkle & Slay backend API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "files": [
            "src/env.php",
            "src/db.php",
            "src/helpers.php",
            "src/jwt.php",
            "src/rateLimiter.php",
            "src/upload.php",
            "src/routes/auth.php",
            "src/routes/collections.php",
            "src/routes/orders.php",
            "src/routes/payments.php",
            "src/routes/settings.php",
            "src/routes/subscribe.php",
            "src/routes/ecocash.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src public",
        "cs-fix": "php-cs-fixer fix"
    }
}