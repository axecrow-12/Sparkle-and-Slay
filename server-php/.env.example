# 127.0.0.1 avoids a Windows IPv6-resolution hang (see README). On cPanel /
# most shared hosting, MySQL users are often grant-restricted to the
# localhost socket — if you get "Access denied" with 127.0.0.1, switch this
# to `localhost` instead.
DB_HOST=127.0.0.1
DB_NAME=sparkle_slay
DB_USER=sparkle_user
DB_PASSWORD=changeme

# Generate a real one before deploying, never reuse the placeholder below:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=REPLACE_WITH_bin2hex_random_bytes_32
JWT_TTL_SECONDS=43200

FRONTEND_ORIGIN=http://localhost:5500

# EcoCash API checkout. Keep these values server-side and replace all examples.
ECOCASH_ENV=preprod
ECOCASH_API_URL=https://payonline.ecocash.co.zw/ecocashGateway-preprod/payment/v1/transactions/amount
ECOCASH_QUERY_BASE_URL=https://payonline.ecocash.co.zw/ecocashGateway-preprod/payment/v1
ECOCASH_API_USERNAME=
ECOCASH_API_PASSWORD=
ECOCASH_MERCHANT_CODE=
ECOCASH_MERCHANT_PIN=
ECOCASH_MERCHANT_NUMBER=
ECOCASH_NOTIFY_URL=https://your-public-domain.example/api/ecocash/notify
ECOCASH_TERMINAL_ID=WEB
ECOCASH_LOCATION=Online
ECOCASH_SUPER_MERCHANT_NAME="Sparkle and Slay"
ECOCASH_MERCHANT_NAME="Sparkle and Slay"
ECOCASH_COUNTRY_CODE=ZW
ECOCASH_TIMEOUT_SECONDS=20
