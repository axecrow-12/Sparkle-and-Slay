# Uploaded files are user supplied. The app only writes jpg, png, webp,
# mp4, and webm here (see src/upload.php), but this file makes sure that
# even if that check were ever bypassed or misconfigured, nothing in this
# folder can be executed as a script.

<FilesMatch "\.(php|phtml|php\d|pht|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

# Belt and braces for older Apache configs that read this directive instead
Options -ExecCGI
php_flag engine off

# Never let a browser second-guess the type of a user-uploaded file, and give
# it no ambient authority if it is ever served as a document.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'"
    Header always set Content-Disposition "inline"
</IfModule>
