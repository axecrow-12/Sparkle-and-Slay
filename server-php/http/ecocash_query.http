# Select the "preprod" environment from the dropdown in the top right of
# this editor before running any of these (PHPStorm reads variables from
# http-client.env.json and http-client.private.env.json automatically).
#
# Run requests in order, top to bottom. Request 1 stores the
# clientCorrelator it used into a global variable if the charge actually
# succeeds, request 2 reuses it. Until your test phone number is
# registered with EcoCash's sandbox, request 1 will likely come back as
# an error response, not a real charge, that is expected, check its raw
# response body to see what EcoCash actually said.


### 1. Charge request against EcoCash preprod
# This confirms Basic Auth is wired correctly and, once your number is
# registered, gives us a real clientCorrelator to query in request 2.
# Expect this to fail with a subscriber related error until testEndUserId
# has actually been registered with EcoCash's test environment (see the
# doc: email the EcoCash point of contact to get a number added). A 401
# here means the auth itself is wrong, anything else means auth passed
# and the failure is about the test number, which is fine for this test.
POST {{ecocashChargeUrl}}
Content-Type: application/json
Authorization: Basic {{ecocashUsername}} {{ecocashPassword}}

{
  "clientCorrelator": "{{$timestamp}}",
  "notifyUrl": "http://localhost:4001/api/ecocash/notify",
  "referenceCode": "TEST_{{$timestamp}}",
  "tranType": "MER",
  "endUserId": "{{testEndUserId}}",
  "remarks": "PHPStorm isolation test",
  "transactionOperationStatus": "Charged",
  "paymentAmount": {
    "charginginformation": {
      "amount": 1.00,
      "currency": "USD",
      "description": "Sparkle and Slay test charge"
    },
    "chargeMetaData": {
      "channel": "WEB",
      "purchaseCategoryCode": "Online Payment",
      "onBeHalfOf": "Sparkle and Slay"
    }
  },
  "merchantCode": "{{testMerchantCode}}",
  "merchantPin": "{{testMerchantPin}}",
  "merchantNumber": "{{testMerchantNumber}}",
  "currencyCode": "USD",
  "countryCode": "ZW",
  "terminalID": "WEB",
  "location": "Online",
  "superMerchantName": "Sparkle and Slay",
  "merchantName": "Sparkle and Slay"
}

> {%
    client.test("Auth accepted, not a 401", function () {
        client.assert(response.status !== 401, "Got 401, Basic Auth header is wrong");
    });

    // Log the raw body no matter what shape it is, this is the fastest
    // way to see EXACTLY what EcoCash rejected the request for (unknown
    // subscriber, bad merchant code, etc) without hunting through panels.
    client.log("Raw response: " + JSON.stringify(response.body));

    // Only chain to request 2 if this was a real charge. An error
    // response from EcoCash will not have this field, and that is fine,
    // it just means request 2 has nothing new to query yet and will
    // fall back to the placeholder value set in http-client.env.json.
    if (response.body && response.body.clientCorrelator) {
        client.global.set("lastClientCorrelator", response.body.clientCorrelator);
        client.test("Captured a clientCorrelator to chain to request 2", function () {});
    } else {
        client.log("No clientCorrelator in the response, this was an error reply, not a real charge. Request 2 will use the placeholder correlator instead and get a 'not found' style response, which is expected until your number is registered.");
    }
%}


### 2. Query the transaction we just created
# This is the exact call ecocashQueryTransaction() makes in ecocash.php.
# Testing it here in isolation confirms the URL shape, the endUserId
# encoding, and the Basic Auth all work before trusting it inside the
# real notify handler. If request 1 did not produce a real charge, this
# will come back as "not found" using the placeholder correlator, that
# is a valid, non crashing result, not a failure of this request.
GET {{ecocashQueryBaseUrl}}/{{testEndUserId}}/transactions/amount/{{lastClientCorrelator}}
Authorization: Basic {{ecocashUsername}} {{ecocashPassword}}

> {%
    client.test("Auth accepted, not a 401", function () {
        client.assert(response.status !== 401, "Got 401, Basic Auth header is wrong");
    });
    client.log("Raw response: " + JSON.stringify(response.body));
%}


### 3. Query a specific known transaction by hand
# Use this once you have a real clientCorrelator from an actual test
# charge (from EcoCash's own dashboard, a teammate's test, or a prior
# successful run of request 1). Replace the value below directly, this
# one does not rely on the chained global variable.
GET {{ecocashQueryBaseUrl}}/{{testEndUserId}}/transactions/amount/SAS-bd465c0b86590fb28b94f458
Authorization: Basic {{ecocashUsername}} {{ecocashPassword}}


### 4. Sanity check our own PHP backend is up
# Not an EcoCash call, just confirms php -S localhost:4001 -t public
# public/index.php is actually running in another terminal before you
# debug anything else. Connection refused here means the server is not
# started, not a bug in this file.
GET {{localApiBaseUrl}}/health
